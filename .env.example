# Copy to .env before running Docker Compose. Change both secrets before any shared deployment.
POSTGRES_DB=smartlibrary
POSTGRES_USER=smartlibrary
POSTGRES_PASSWORD=change-this-database-password
JWT_SIGNING_KEY=change-this-to-a-random-secret-with-at-least-32-characters
SEED_ADMIN_EMAIL=admin@smartlibrary.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026!

# Local use defaults; set Production and your public HTTPS origin for a deployment.
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_ORIGIN=http://localhost:5173
# Optional public API base URL used while building the frontend.
VITE_API_BASE_URL=http://localhost:5180

# Gmail SMTP (use a Google App Password, never your normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_FROM_NAME=SmartLibrary

# Optional Gemini free tier; create your own key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
